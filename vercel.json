{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page_id",
          "value": "49"
        }
      ],
      "destination": "https://feline-consulting.be/services/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.feline-consulting.be"
        }
      ],
      "destination": "https://feline-consulting.be/:path*",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "feline-consulting.vercel.app"
        }
      ],
      "destination": "https://feline-consulting.be/:path*",
      "permanent": true
    }
  ]
}
