---
import '../styles/styles.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/refinements.scss';
import '../styles/content-enhancements.scss';
import '../styles/studio-system.scss';
const { pageTitle, pageType, description = "Feline Consulting in België: persoonlijk grafisch ontwerp, logo’s, branding en geboorte- en huwelijksdrukwerk." } = Astro.props;
---

<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ga naar inhoud</a>
    <Header pageType={pageType}/>
    <main class="main" id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <script>
      import "../scripts/menu.js";
    </script>
  </body>
</html>
