---
import '../styles/footer-styles.scss';
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Feline Consulting — naar de homepage">Feline Consulting</a>
      <p>Persoonlijk grafisch ontwerp voor jouw merk en bijzondere momenten.</p>
      <a class="footer-project-link" href="/contact/">Vertel ons je idee <span aria-hidden="true">→</span></a>
    </div>

    <nav class="footer-nav" aria-label="Voettekst navigatie">
      <h2 class="footer-heading">Ontdek Feline</h2>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about/">Over ons</a></li>
        <li><a href="/services/">Diensten</a></li>
        <li><a href="/portfolio/">Portfolio</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/blog/">Blog</a></li>
      </ul>
    </nav>

    <div class="footer-contact">
      <h2 class="footer-heading">Laten we kennismaken</h2>
      <a class="footer-email" href="mailto:jolien@feline-consulting.be">jolien@feline-consulting.be</a>
      <address>Halle-dorp 136 bus 2<br />2980 Zoersel, België</address>
      <p class="footer-vat">BTW BE0787.715.224</p>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Feline Consulting</p>
    <nav aria-label="Beleid en voorwaarden">
      <a href="/privacy/">Privacybeleid</a>
      <a href="/cookiepolicy/">Cookiebeleid</a>
      <a href="/terms-conditions/">Voorwaarden</a>
    </nav>
  </div>
</footer>
