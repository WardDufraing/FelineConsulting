---
import { Image } from 'astro:assets';
import { blogImage } from '../lib/blog-images';
import '../styles/blogCard-styles.scss';

export interface Props {
  title: string;
  excerpt: string;
  href: string;
  img: string;
}

const { title, excerpt, href, img } = Astro.props;
---

<article class="blog-card">
  <Image loading="lazy" decoding="async" src={blogImage(img)} widths={[400, 800]} sizes="(max-width: 635px) 90vw, (max-width: 1023px) 45vw, 360px" alt={title} class="blog-thumbnail" />
  <div class="blog-content">
    <p class="blog-kicker">Ontwerptip</p>
    <h2 class="blog-heading">{title}</h2>
    <p class="blog-excerpt">{excerpt}</p>
    <a href={href} class="blog-readmore" aria-label={`Lees meer: ${title}`}>Lees meer →</a>
  </div>
</article>