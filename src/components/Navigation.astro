---
import { Picture } from 'astro:assets';
import orangeLogo from '../../public/Logo_Orange.png';

const { pageType } = Astro.props;
---

<div class={pageType === 'index' ? 'nav-container bg-index' : 'nav-container bg-wave'} id="nav-container">
    <nav class="nav-links" id="nav-links" aria-label="Hoofdnavigatie">
        
        <a class={`nav-link ${pageType === 'index' ? 'active' : ''}`} aria-current={pageType === 'index' ? 'page' : undefined} href="/">Home</a>
        <a class={`nav-link ${pageType === 'about' ? 'active' : ''}`} aria-current={pageType === 'about' ? 'page' : undefined} href="/about/">Over ons</a>
        <a class={`nav-link ${pageType === 'services' ? 'active' : ''}`} aria-current={pageType === 'services' ? 'page' : undefined} href="/services/">Diensten</a>
        <a class="home-link" href="/">
            <div class="header-image">
                <Picture src={orangeLogo} alt="Feline Consulting"/>
            </div>
        </a>
        <a class={`nav-link ${pageType === 'portfolio' ? 'active' : ''}`} aria-current={pageType === 'portfolio' ? 'page' : undefined} href="/portfolio/">Portfolio</a>
        <a class={`nav-link ${pageType === 'contact' ? 'active' : ''}`} aria-current={pageType === 'contact' ? 'page' : undefined} href="/contact/">Contact</a>
        <a class={`nav-link ${pageType === 'blog' ? 'active' : ''}`} aria-current={pageType === 'blog' ? 'page' : undefined} href="/blog/">Blog</a>
    </nav>
</div>