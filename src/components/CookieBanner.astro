---
import '../styles/cookieBanner-styles.scss';
import { isPreview } from '../lib/site';
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
const enabled = !isPreview && /^G-[A-Z0-9]+$/.test(measurementId);
---
<div id="cookie-banner" class="cookie-banner hidden" role="region" aria-label="Cookievoorkeur" data-measurement-id={enabled ? measurementId : ''} data-analytics-enabled={String(enabled)}>
  <p class="cookie-message">Met jouw toestemming gebruiken we Google Analytics om te begrijpen hoe de website wordt gebruikt. Weiger je, dan blijven statistieken uit. Het contactformulier werkt bij beide keuzes. <a href="/cookiepolicy/" class="cookie-link">Lees meer</a></p>
  <div class="cookie-actions">
    <button id="accept-cookies" class="cookie-accept-button">Statistieken toestaan</button>
    <button id="reject-cookies" class="cookie-reject-button">Alleen noodzakelijk</button>
  </div>
</div>
<script>
  import { initAnalyticsConsent } from '../scripts/analytics';
  initAnalyticsConsent();
</script>
