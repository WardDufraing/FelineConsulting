---
export const prerender = true;
import 'swiper/css';
import 'swiper/css/pagination';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCallout from '../components/ProjectCallout.astro';
import PortfolioCarousel from '../components/Carousel.tsx';

import '../styles/portfolio-styles.scss';

const pageTitle = "Ontwerpvoorbeelden: logo & uitnodigingen | Feline Consulting";
const pageType = "portfolio";

const logoImages = [
  '/images/portfolio/logos/logo1.webp'
];

const inviteImages = [
  '/images/portfolio/invites/invite1.webp',
  '/images/portfolio/invites/invite2.webp',
  '/images/portfolio/invites/invite3.webp'
];
---
<BaseLayout description="Bekijk de beschikbare ontwerpvoorbeelden van Feline Consulting: een eigen merkidentiteit en uitnodigingen als inspiratie voor jouw project." pageTitle={pageTitle} pageType={pageType}>
<div class="portfolio-page studio-page">
    <PageIntro eyebrow="Ontwerp in beeld" title="Een verhaal krijgt vorm." description="Van de eigen merkidentiteit van Feline Consulting tot uitnodigingen: ontdek de beschikbare voorbeelden en vertel welke sfeer jou aanspreekt." />
    <section class="portfolio-showcase"><h2>Het logo en de identiteit van Feline Consulting</h2><p class="section-lead">Het logo van Feline Consulting brengt de naam en de zachte, persoonlijke uitstraling van het merk samen.</p>
    <PortfolioCarousel images={logoImages} title="Logo-ontwerpen" client:visible />
    </section>
    <section class="portfolio-showcase portfolio-showcase-warm">
    <h2>Uitnodigingen en persoonlijk drukwerk</h2><p class="section-lead">Kijk naar de combinatie van typografie, kleur en compositie. Wat spreekt je aan: rustig, speels, uitgesproken of verfijnd?</p>
    <PortfolioCarousel images={inviteImages} title="Uitnodigingsontwerpen" client:visible />
    </section>
    <section class="content-section editorial-section" aria-labelledby="examples-context-title"><h2 id="examples-context-title">Zo gebruik je ontwerpvoorbeelden als inspiratie.</h2><p>Een voorbeeld hoeft niet precies te tonen wat je zoekt. Benoem welke kleur, letter of sfeer je aanspreekt en wat je liever anders ziet. Die uitleg helpt om een eigen richting te vinden, in plaats van een bestaand ontwerp over te nemen.</p><p>Zoek je herkenbaarheid voor je onderneming? Bekijk <a href="/services/#merken">logo- en huisstijlontwerp</a>. Voor een geboorte, huwelijk of feest lees je meer over <a href="/services/#kaartjes">persoonlijke kaartjes en uitnodigingen</a>.</p></section>
    <ProjectCallout title="Welke stijl spreekt jou aan?" text="Vertel welke voorbeelden je mooi vindt en waarom. Je mag ook eigen inspiratiebeelden of een korte beschrijving van je gewenste sfeer meebrengen." />
    </div>
</BaseLayout>