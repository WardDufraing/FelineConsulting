---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCallout from '../components/ProjectCallout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

import '../styles/blog-styles.scss';

const pageTitle = "Blog - Feline Consulting";
const pageType = "blog"
const blogPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout description="Praktische ontwerptips over branding, geboortekaartjes en typografie. Heldere uitleg om betere keuzes te maken voor jouw ontwerp." pageTitle={pageTitle} pageType={pageType}>
  <div class="blog-page">
    <section class="blog-intro">
      <h1 class="blog-title">Blog</h1>
      <p>Van een herkenbare huisstijl tot een persoonlijk geboortekaartje: hier vind je praktische tips om je ontwerpvraag scherper te maken. Kies een onderwerp en neem de aandachtspunten mee naar je eigen project.</p>
    </section>

    <section class="blog-grid">
      {blogPosts.map((post: CollectionEntry<"blog">) => (
        <BlogCard
          title={post.data.title}
          excerpt={post.data.excerpt}
          href={`/blog/${post.id}`}
          img={post.data.img}
        />
      ))}
    </section>

    <ProjectCallout title="Van inspiratie naar jouw ontwerp" text="Heb je na het lezen een concrete vraag? Vertel ons wat je wil maken en welke keuzes nog openstaan." />
    <script>
      const cards = document.querySelectorAll('.blog-card');

      const observer = new IntersectionObserver(entries => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add('visible');
            }, index * 100);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      cards.forEach(card => observer.observe(card));
    </script>
  </div>
</BaseLayout>


