---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCallout from '../components/ProjectCallout.astro';

import '../styles/about-styles.scss';

const pageTitle = "Over Feline Consulting";
const pageType = "about"
---

<BaseLayout description="Maak kennis met Jolien en de persoonlijke aanpak van Feline Consulting. Doordacht grafisch ontwerp voor ondernemers en bijzondere momenten." pageTitle={pageTitle} pageType={pageType}>
  <div class="about-page">
    <section class="about-title-section">
      <h1 class="about-title">Over Feline Consulting</h1>

      <p>
        Feline Consulting is het creatieve project van Jolien, een gepassioneerde grafisch ontwerpster met oog voor detail en gevoel voor stijl. Of het nu gaat om een geboortekaartje, een uitnodiging, een logo of een volledige branding — elk ontwerp is doordacht, persoonlijk en tot in de puntjes afgewerkt.
      </p>
      </section>
      <section class="about-grid">
        <div class="about-card">
          <h2>Wie we zijn</h2>
          <p>
            Jolien startte Feline Consulting met de droom om mensen en merken te helpen hun verhaal visueel tot leven te brengen. Ze combineert creativiteit met structuur, waardoor elk project vlot verloopt en tot een resultaat leidt waar jij trots op kan zijn.
          </p>
        </div>
        <div class="about-card">
          <h2>Wat we doen</h2>
          <p>
            We bieden grafische ontwerpen op maat aan voor zowel particulieren als bedrijven. Denk aan:
          </p>
          <ul>
            <li>Geboorte- en huwelijksdrukwerk</li>
            <li>Logo’s & huisstijl</li>
            <li>Promotiemateriaal</li>
            <li>Social media visuals</li>
            <li>Drukwerk en begeleiding van A tot Z</li>
          </ul>
        </div>
        <div class="about-card">
          <h2>Onze aanpak</h2>
          <p>
            We luisteren eerst goed naar jouw wensen en gaan dan creatief aan de slag. Transparantie, communicatie en kwaliteit staan centraal. We geloven dat elk project uniek is en zetten in op een persoonlijke aanpak.
          </p>
        </div>
        <div class="about-card">
          <h2>Waarom Feline?</h2>
          <p>
            Omdat we niet enkel willen ontwerpen wat er goed uitziet — we willen iets creëren dat klopt, dat raakt en dat blijft hangen. Design met gevoel dus. En een glimlach natuurlijk.
          </p>
        </div>
      </section>
    <section class="content-section" aria-labelledby="about-values">
      <h2 id="about-values">Van een mooi idee naar een bruikbaar ontwerp</h2>
      <p class="section-lead">Een ontwerp moet niet alleen bij je passen, maar ook werken op de plekken waar je het gebruikt.</p>
      <div class="content-grid">
        <article class="content-card"><h3>Jouw verhaal als vertrekpunt</h3><p>Inspiratiebeelden zijn welkom, maar je hoeft nog geen uitgewerkt plan te hebben. Vertel vooral wat je wil overbrengen en voor wie het bedoeld is.</p></article>
        <article class="content-card"><h3>Aandacht voor het geheel</h3><p>Kleuren, letters, beeld en materiaal versterken elkaar. Daarom bekijken we een ontwerp in zijn context: op een scherm, op papier of als onderdeel van je huisstijl.</p></article>
      </div>
    </section>
    <ProjectCallout title="Past onze aanpak bij jouw idee?" text="Ontdek de diensten of vertel ons alvast waar je naar op zoek bent." />
  </div>
  <script>
    const cards = document.querySelectorAll('.about-card');
  
    const observer = new IntersectionObserver(entries => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          // Stagger each card by 100ms
          setTimeout(() => {
            entry.target.classList.add('visible');
          }, index * 100);
  
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
  
    cards.forEach(card => observer.observe(card));
  </script>
</BaseLayout>
