---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import '../styles/contact-styles.scss';

const pageTitle = "Contact - Feline Consulting";
const pageType = "contact";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout description="Bespreek jouw ontwerpidee met Feline Consulting. Vertel over je project, gewenste timing en stijl, of mail rechtstreeks naar Jolien." pageTitle={pageTitle} pageType={pageType}>
  <div class="contact">
    <section class="contact-section">
      <PageIntro eyebrow="Laten we kennismaken" title="Vertel ons je idee." description="Een logo, kaartje of huisstijl in gedachten? Vertel ons wat je wil maken. Een eerste idee is genoeg om het gesprek te starten." />

      <details class="brief-help"><summary>Wat zet ik in mijn bericht?</summary><ul><li>Wat wil je laten ontwerpen en voor wie?</li><li>Waar ga je het gebruiken: online, op papier of allebei?</li><li>Heb je een gewenste datum of een budget in gedachten?</li><li>Welke stijl of voorbeelden spreken je aan?</li></ul><p>Je hoeft nog niet op alles een antwoord te hebben. Begin gerust met je idee.</p></details>
      <form
        id="contact-form"
        action="/api/contact/"
        method="POST"
        class="contact-form"
      >
        <p class="form-note">Alle velden zijn verplicht. Deel alleen gegevens die nodig zijn om je vraag te beantwoorden.</p>
        <!-- Honeypot -->
        <input type="text" name="_honey" hidden tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="submissionId" id="submission-id" />

        <div class="form-input-container">
          <label for="name" class="form-label">Naam</label>
          <input
            type="text"
            name="name"
            id="name"
            autocomplete="name"
            required
            maxlength="120"
            class="form-input"
          />
        </div>

        <div class="form-input-container">
          <label for="email" class="form-label">E-mailadres</label>
          <input
            type="email"
            name="email"
            id="email"
            autocomplete="email"
            inputmode="email"
            autocapitalize="none"
            spellcheck="false"
            maxlength="254"
            required
            class="form-input"
          />
        </div>

        <div class="form-input-container">
          <label for="message" class="form-label">Bericht</label>
          <textarea
            name="message"
            id="message"
            aria-describedby="message-help"
            rows="5"
            maxlength="8000"
            required
            class="form-input"
          ></textarea>
          <p id="message-help" class="field-help">Een korte beschrijving van je idee en gewenste timing is genoeg om te beginnen.</p>
        </div>

        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-theme="light" data-appearance="interaction-only"></div>}
        <noscript><p>Gebruik je e-mailapp om Jolien te bereiken; het formulier heeft JavaScript nodig voor de spamcontrole.</p></noscript>
        <p class="form-note">Je bericht wordt naar Jolien gestuurd. Lees hoe dit werkt in ons <a href="/privacy/">privacybeleid</a>.</p>
        <button type="submit" class="form-button" disabled>
          <span class="button-text">Verstuur</span>
          <span class="button-loader hidden" aria-hidden="true"></span>
        </button>

        <p role="status" aria-live="polite" aria-atomic="true" class="form-confirmation-message"></p>
      </form>

      <p class="contact-alternative">Liever via je e-mailapp, of lukt het versturen niet? <a id="email-draft-link" href="mailto:jolien@feline-consulting.be">Open een e-mail aan Jolien</a></p>

      {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
      <script>
        const form = document.querySelector<HTMLFormElement>('#contact-form');
        const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitButton) submitButton.disabled = false;
        const submissionId = document.querySelector<HTMLInputElement>('#submission-id');
        const newSubmission = () => { if (submissionId) submissionId.value = crypto.randomUUID(); };
        newSubmission();
        form?.addEventListener('input', event => {
          if ((event.target as HTMLElement)?.classList.contains('form-input')) newSubmission();
        });
        form?.addEventListener('submit', async event => {
          event.preventDefault();
          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          const message = form.querySelector<HTMLElement>('.form-confirmation-message');
          const text = form.querySelector<HTMLElement>('.button-text');
          if (!button || !message || !text || button.disabled) return;
          button.disabled = true;
          form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.form-input').forEach(field => { field.readOnly = true; });
          form.setAttribute('aria-busy', 'true');
          text.textContent = 'Bezig met versturen…';
          message.textContent = '';
          let feedback = '';
          let failed = false;
          try {
            const response = await fetch(form.action, {
              method: 'POST', body: new FormData(form),
              headers: { Accept: 'application/json' },
              signal: AbortSignal.timeout(20000)
            });
            const result = await response.json();
            if (!response.ok || result.success !== true) {
              if (result.error === 'verification_required') feedback = 'Rond de spamcontrole af en probeer opnieuw. Je tekst is bewaard.';
              if (result.error === 'invalid_fields') feedback = 'Controleer je naam, e-mailadres en bericht. Je tekst is bewaard.';
              if (result.error === 'too_large') feedback = 'Je bericht is te lang. Verkort je tekst of open hieronder een e-mail aan Jolien.';
              if (result.error === 'unavailable') feedback = 'Het formulier is tijdelijk niet beschikbaar. Je tekst is bewaard; open hieronder een e-mail aan Jolien.';
              throw new Error('Submission failed');
            }
            feedback = 'Bedankt! Je bericht is ingediend. Jolien kan je via het opgegeven e-mailadres beantwoorden.';
            form.reset();
            newSubmission();
            updateEmailDraft();
          } catch {
            feedback ||= 'We konden niet bevestigen dat je bericht is verstuurd. Je tekst is bewaard. Probeer opnieuw of open hieronder een e-mail aan Jolien.';
            failed = true;
          } finally {
            button.disabled = false;
            form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.form-input').forEach(field => { field.readOnly = false; });
            form.removeAttribute('aria-busy');
            text.textContent = 'Verstuur';
            try { (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset(); } catch { /* Widget may still be loading. */ }
            message.classList.toggle('error', failed);
            message.textContent = feedback;
          }
        });
        const emailDraft = document.querySelector<HTMLAnchorElement>('#email-draft-link');
        function updateEmailDraft() {
          if (!emailDraft) return;
          const value = (name: string) => (form?.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? '';
          const body = `Naam: ${value('name')}\nE-mailadres: ${value('email')}\n\n${value('message')}`;
          emailDraft.href = `mailto:jolien@feline-consulting.be?subject=${encodeURIComponent('Ontwerpvraag via Feline Consulting')}&body=${encodeURIComponent(body)}`;
        }
        form?.addEventListener('input', updateEmailDraft);
        emailDraft?.addEventListener('focus', updateEmailDraft);
        emailDraft?.addEventListener('click', updateEmailDraft);
        updateEmailDraft();
      </script>
    </section>
  </div>
</BaseLayout>