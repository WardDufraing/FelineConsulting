---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import '../styles/contact-styles.scss';

const pageTitle = "Contact - Feline Consulting";
const pageType = "contact"
---

<BaseLayout description="Bespreek jouw ontwerpidee met Feline Consulting. Vertel over je project, gewenste timing en stijl, of mail rechtstreeks naar Jolien." pageTitle={pageTitle} pageType={pageType}>
  <div class="contact">
    <section class="contact-section">
      <PageIntro eyebrow="Laten we kennismaken" title="Vertel ons je idee." description="Een logo, kaartje of huisstijl in gedachten? Vertel ons wat je wil maken. Een eerste idee is genoeg om het gesprek te starten." />

      <details class="brief-help"><summary>Wat zet ik in mijn bericht?</summary><ul><li>Wat wil je laten ontwerpen en voor wie?</li><li>Waar ga je het gebruiken: online, op papier of allebei?</li><li>Heb je een gewenste datum of een budget in gedachten?</li><li>Welke stijl of voorbeelden spreken je aan?</li></ul><p>Je hoeft nog niet op alles een antwoord te hebben. Begin gerust met je idee.</p></details>
      <form
        id="contact-form"
        action="https://formsubmit.co/jolien@feline-consulting.be"
        method="POST"
        class="contact-form"
      >
        <p class="form-note">Alle velden zijn verplicht. Deel alleen gegevens die nodig zijn om je vraag te beantwoorden.</p>
        <!-- Honeypot -->
        <input type="text" name="_honey" style="display:none" tabindex="-1" />

        <!-- Disable CAPTCHA -->
        <input type="hidden" name="_captcha" value="false" />

        <div class="form-input-container">
          <label for="name" class="form-label">Naam</label>
          <input
            type="text"
            name="name"
            id="name"
            autocomplete="name"
            required
            minlength="2"
            class="form-input"
          />
        </div>

        <div class="form-input-container">
          <label for="email" class="form-label">E-mailadres</label>
          <input
            type="email"
            name="email"
            id="email"
            autocomplete="email"
            required
            class="form-input"
          />
        </div>

        <div class="form-input-container">
          <label for="message" class="form-label">Bericht</label>
          <textarea
            name="message"
            id="message"
            aria-describedby="message-help"
            rows="5"
            required
            class="form-input"
          ></textarea>
          <p id="message-help" class="field-help">Een korte beschrijving van je idee en gewenste timing is genoeg om te beginnen.</p>
        </div>

        <p class="form-note">Je bericht wordt via FormSubmit naar Jolien gestuurd. Lees hoe dit werkt in ons <a href="/privacy/">privacybeleid</a>.</p>
        <button type="submit" class="form-button">
          <span class="button-text">Verstuur</span>
          <span class="button-loader hidden" aria-hidden="true"></span>
        </button>

        <p role="status" aria-live="polite" class="form-confirmation-message hidden">Bedankt voor je bericht! We nemen snel contact met je op.</p>
      </form>

      <p class="contact-alternative">Liever rechtstreeks mailen? <a href="mailto:jolien@feline-consulting.be">jolien@feline-consulting.be</a></p>

      <script>
        const form = document.querySelector<HTMLFormElement>('#contact-form');
        form?.addEventListener('submit', async event => {
          event.preventDefault();
          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          const message = form.querySelector<HTMLElement>('.form-confirmation-message');
          const text = form.querySelector<HTMLElement>('.button-text');
          if (!button || !message || !text || button.disabled) return;
          button.disabled = true;
          form.setAttribute('aria-busy', 'true');
          text.textContent = 'Bezig met versturen…';
          message.classList.add('hidden');
          try {
            const response = await fetch(form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/'), {
              method: 'POST', body: new FormData(form),
              headers: { Accept: 'application/json' },
              signal: AbortSignal.timeout(15000)
            });
            const result = await response.json();
            if (!response.ok || ![true, 'true'].includes(result.success)) throw new Error('Submission failed');
            message.textContent = 'Bedankt voor je bericht! We nemen snel contact met je op.';
            message.classList.remove('error');
            form.reset();
          } catch {
            message.textContent = 'Versturen is niet gelukt. Probeer opnieuw of mail naar jolien@feline-consulting.be.';
            message.classList.add('error');
          } finally {
            button.disabled = false;
            form.removeAttribute('aria-busy');
            text.textContent = 'Verstuur';
            message.classList.remove('hidden');
          }
        });
      </script>
    </section>
  </div>
</BaseLayout>